{
  "name": "@samourai/design-tokens",
  "version": "0.2.0",
  "description": "Design tokens of Kodera: DTCG source, generated CSS variables and Tailwind preset, contrast gate",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samouraiworld/kodera-design-tokens.git"
  },
  "files": [
    "dist",
    "tokens.json",
    "test/token-test.mjs"
  ],
  "exports": {
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tailwind.preset.js",
      "default": "./dist/tailwind.preset.js"
    },
    "./token-test": "./test/token-test.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/tokens.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:grammar": "node scripts/check-grammar.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:drift": "node scripts/build.mjs --check",
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
